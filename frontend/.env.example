NEXT_PUBLIC_API_URL=http://localhost:8000

# Production Vercel: server-side only. Do not prefix these names with NEXT_PUBLIC_.
# BACKEND_URL=https://your-backend.onrender.com
# BACKEND_API_TOKEN=<same value as backend API_ACCESS_TOKEN>
# In production the browser uses the same-origin /api proxy automatically.
# NEXT_PUBLIC_API_URL is only used for direct API access in local development.
