# Copy to backend/.env. Never put this secret in frontend NEXT_PUBLIC variables.
ALPHAVANTAGE_API_KEY=your_key_here

# Backend-local automation. Restart the backend after changing these values.
AUTO_SYNC_ENABLED=true
AUTO_FORECAST_ENABLED=true

# Replace with a genuine contact email; SEC does not require an API key.
SEC_USER_AGENT=MarketLab your-email@example.com

# Independent SEC report worker; cache 6h, retry 30m. Requires SEC_USER_AGENT.
AUTO_FUNDAMENTALS_ENABLED=true

# EURUSD macro connector only. Obtain from https://fred.stlouisfed.org/docs/api/api_key.html
# Use only in backend/.env; never expose through NEXT_PUBLIC variables.
FRED_API_KEY=your_fred_key_here
# BTC network and ECB endpoints do not use this key.
